# Google AI Studio API key (server-side only; create at https://aistudio.google.com)
GEMINI_API_KEY=
# Routine advisory, follow-up, and image analysis model; current Flash-class default.
GEMINI_MODEL=gemini-3.8-flash
# Optional Live model (currently supported ID: gemini-3.8-live). Leave blank unless enabled
# for this project; Live has separate model access, quotas, and usage charges.
GEMINI_LIVE_MODEL=
# Earth Engine: GCP project with EE enabled; on Cloud Run the service account is used automatically
EE_PROJECT=
EE_PROJECT_ID=
EE_SERVICE_ACCOUNT_JSON=
# Max distance (metres) for "Planet data exists here"
PLANET_RADIUS_M=300
